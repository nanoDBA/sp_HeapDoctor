# Whitelist approach: ignore everything, then allow specific files
*

# Allow these files
!.gitignore
!.gitattributes
!README.md
!LICENSE
!sp_HeapDoctor.sql
!STYLE_GUIDE.md
!CONTRACTS.md
!tools/
!tools/*.sql
# Tests: *.sql files, plus the suite runner. Other shell scripts and
# README_TESTING.md contain environment-specific defaults like hostnames and
# credentials, so they stay local. run_suite.sh takes its connection details
# from arguments or HEAPDOCTOR_SQLCMD and hardcodes neither.
!tests/
!tests/*.sql
!tests/run_suite.sh
!tests/test_lock_timeout.sh

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
